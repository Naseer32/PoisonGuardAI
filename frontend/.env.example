# Copy to .env, edit, then:  node --env-file=.env scripts/make-config.mjs
# Address you reported as deployed on Bradbury. The app never assumes it is live: it reads the chain and says what it finds.
PG_CONTRACT_ADDRESS=0x0932c34aa6e664245f7C3A7D4944B24217d9F061
# Name of the chain export inside genlayer-js to use. If wrong, the app lists the names the SDK really exports.
PG_CHAIN_KEY=testnetBradbury
PG_NETWORK_LABEL=Bradbury
# genlayer-js package URL. PIN AN EXACT VERSION after checking npm, e.g. https://esm.sh/genlayer-js@X.Y.Z
PG_SDK_URL=https://esm.sh/genlayer-js
# Optional: override the RPC endpoint (otherwise the SDK chain default is used)
PG_RPC_URL=
# Optional: explorer transaction URL with {hash}. Leave empty if you do not know it; the app will not invent one.
PG_EXPLORER_TX_URL=
